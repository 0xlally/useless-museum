# Copy to .env on the server. Never put this key in a VITE_* variable.
LUX3D_API_KEY=
PORT=8787
HOST=127.0.0.1
# Official production gateway. Authorization is the raw key, without Bearer.
LUX3D_BASE_URL=https://api.aholo3d.cn
LUX3D_VERSION=G1
# Download hosts must match these domains or their subdomains. Add a new
# domain only after verifying an actual official task result.
LUX3D_ASSET_HOSTS=kujiale.com,coohom.com,aholo3d.cn,myqcloud.com
# Optional comma-separated browser origins allowed to POST (for a tunnel or an
# alternate dev port). Same-origin requests and the local Vite 5173 dev server
# are already allowed. Never add an origin you do not control.
LUX3D_ALLOWED_ORIGINS=
